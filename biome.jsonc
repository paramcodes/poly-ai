{
	"$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!node_modules",
			"!.next",
			"!dist",
			"!build",
			"!docs/evidence",
			"!test-results",
			"!playwright-report"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		},
		"domains": {
			"next": "recommended",
			"react": "recommended"
		}
	},
	"overrides": [
		{
			/*
			 * `src/components/ui/` holds shadcn registry components. They are
			 * vendored verbatim so that `npx shadcn add` can overwrite them
			 * without a merge conflict, which means we do not rewrite them to
			 * satisfy lint rules. The two rules relaxed here fire on the
			 * registry's own patterns: the sidebar's `document.cookie` read and
			 * its deliberately partial effect dependencies.
			 */
			"includes": ["src/components/ui/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noDocumentCookie": "off"
					},
					"correctness": {
						"useExhaustiveDependencies": "off"
					}
				}
			}
		}
	],
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
