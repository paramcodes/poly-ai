# ─── Database ────────────────────────────────────────────────────────────────
# Postgres connection string. Neon serverless works well here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ─── Auth ────────────────────────────────────────────────────────────────────
# 32+ characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of the deployment, used for auth callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional OAuth providers. Leave blank to run with email + password only.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Key encryption ──────────────────────────────────────────────────────────
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Rotating this invalidates every stored provider key unless you re-encrypt.
KEY_ENCRYPTION_SECRET=""

# ─── Media storage ───────────────────────────────────────────────────────────
# Upstash Blob. Swap the StorageAdapter implementation for Cloudflare R2 if
# video egress costs become a problem.
BLOB_READ_WRITE_TOKEN=""

# ─── Commit discipline ───────────────────────────────────────────────────────
# Maximum tokens of diff allowed in a single commit. Raise only deliberately.
COMMIT_TOKEN_LIMIT="3000"
